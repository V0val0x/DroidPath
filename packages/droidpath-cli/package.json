{
  "name": "droidpath",
  "version": "2.0.0",
  "description": "Zero-friction 1-click CLI for DroidPath — auto-injects Android Shadow DOM daemon (adb push/forward/app_process), configures Cursor/Claude MCP, and launches native A* UI router.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/V0val0x/DroidPath.git",
    "directory": "packages/droidpath-cli"
  },
  "bin": {
    "droidpath": "./bin/droidpath.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "assets/android-daemon.jar"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync-daemon": "node scripts/sync-daemon.mjs",
    "test": "node --test test/cli.test.mjs"
  },
  "keywords": [
    "android",
    "mcp",
    "adb",
    "automation",
    "ai-agent",
    "shadow-dom",
    "astar",
    "cursor",
    "claude"
  ]
}
