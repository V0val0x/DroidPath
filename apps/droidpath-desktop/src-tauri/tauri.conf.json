{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroidPath",
  "version": "2.3.0",
  "identifier": "dev.droidpath.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DroidPath — Cross-Platform Agentic HUD",
        "width": 1120,
        "height": 840,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/droidpath-cli/assets/android-daemon.jar": "android-daemon.jar"
    }
  }
}
